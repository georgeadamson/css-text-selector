{
  "name": "css-text-selector",
  "version": "1.0.7",
  "type": "module",
  "description": "Add data-contains attributes so CSS can match DOM elements by textContent.",
  "main": "./dist/css-text-selector.js",
  "module": "./dist/css-text-selector.module.js",
  "browser": "./dist/css-text-selector.js",
  "types": "./css-text-selector.d.ts",
  "exports": {
    ".": {
      "import": "./dist/css-text-selector.module.js",
      "require": "./dist/css-text-selector.js",
      "types": "./css-text-selector.d.ts",
      "default": "./dist/css-text-selector.module.js"
    },
    "./dist/css-text-selector.js": "./dist/css-text-selector.js",
    "./dist/css-text-selector.min.js": "./dist/css-text-selector.min.js",
    "./dist/css-text-selector.module.js": "./dist/css-text-selector.module.js",
    "./dist/css-text-selector.module.min.js": "./dist/css-text-selector.module.min.js"
  },
  "files": [
    "dist",
    "css-text-selector.d.ts",
    "README.md"
  ],
  "keywords": [
    "css",
    "selector",
    "text",
    "text-content",
    "textcontent",
    "innertext",
    "contains",
    "css-contains",
    "css-has-text",
    "text-selector",
    "attribute-selector",
    "data-attribute",
    "data-contains",
    "dom",
    "mutationobserver",
    "browser",
    "javascript",
    "accessibility",
    "testing"
  ],
  "scripts": {
    "dev": "vite",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/main.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90",
    "build": "node build.js",
    "preview": "vite preview",
    "bump": "npm version patch && git push"
  },
  "devDependencies": {
    "terser": "^5.48.0",
    "vite": "^8.1.0"
  }
